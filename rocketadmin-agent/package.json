		"inquirer": "^14.2.3",
		"ora": "^9.4.1",
		"rimraf": "^6.1.3",
		"wait-on": "^9.5.1",
		"winston": "^3.19.0",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@types/inquirer": "^9.0.10",
		"@types/node": "^22.20.5",
		"@types/ws": "^8.18.2",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
