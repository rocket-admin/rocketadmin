{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/src/version.ts",
			"!**/index.saas.html",
			"!**/storybook-static",
			"!**/dist-e2e",
			"!**/public/assets"
		]
	},
	"overrides": [
		{
			"includes": ["**/*.vue"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		}
	]
}
